# Local development database created by scripts/setup_database.sql.
# Demo credentials only. Never reuse or commit real credentials.
# Production credentials should come from a secret manager.

# Choose "database" for PostgreSQL (default) or "memory" for temporary
# process-local storage that resets when the API restarts.
STORAGE_BACKEND=database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/library

# Set to true to print SQLAlchemy-generated SQL in the development terminal.
DATABASE_ECHO_SQL=true

# Classroom Bearer tokens for the two request roles. These values demonstrate
# request authentication and role-based authorization; they are not production
# secrets. The member role may read Books and Members. The admin role may also
# create, replace, and delete them.
DEMO_MEMBER_TOKEN=member-demo-token
DEMO_ADMIN_TOKEN=admin-demo-token
